# Search-R1 镜像 Dockerfile (适用于 AutoDL 自定义镜像 / 本地构建后上传)
# 构建: docker build -f Dockerfile.autodl -t search-r1:autodl .
# AutoDL 可把此镜像导入为「自定义镜像」后创建实例

FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Miniconda
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh
ENV PATH=/opt/conda/bin:$PATH

WORKDIR /workspace

# 复制项目（构建时需在仓库根目录，.dockerignore 已排除大文件）
COPY requirements.txt setup.py pyproject.toml ./
COPY verl ./verl
COPY search_r1 ./search_r1
COPY scripts ./scripts
COPY train_ppo.sh retrieval_launch.sh infer.py ./

# Search-R1 主环境
RUN conda create -n searchr1 python=3.9 -y \
    && . /opt/conda/etc/profile.d/conda.sh && conda activate searchr1 \
    && pip install torch==2.4.0 --index-url https://download.pytorch.org/whl/cu121 \
    && pip install vllm==0.6.3 -i $PIP_INDEX_URL \
    && pip install -r requirements.txt -i $PIP_INDEX_URL \
    && pip install -e . -i $PIP_INDEX_URL \
    && pip install wandb -i $PIP_INDEX_URL
# flash-attn 可选，构建较慢；若需要可在容器内手动: pip install flash-attn --no-build-isolation
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate searchr1 && pip install flash-attn --no-build-isolation -i $PIP_INDEX_URL || true

# 默认工作目录与入口
WORKDIR /workspace
RUN echo 'conda activate searchr1' >> /root/.bashrc

CMD ["/bin/bash"]
